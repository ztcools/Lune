# ============================================================
# Lune Agent 本地开发配置模板（可提交到 Git）
# 使用方式: cp application-local.yml.template application-local.yml
#          然后填入真实 API Key
# ============================================================

spring:
  data:
    redis:
      host: localhost
      port: 6379

app:
  agent:
    api-key: your-api-key-here
  lune:
    base-url: http://localhost:8081

logging:
  level:
    com.lune.agent: DEBUG
