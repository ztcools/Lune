# ============================================================
# Lune .gitignore
# ============================================================

# --- Maven ---
target/
*.jar
*.war

# --- Node ---
node_modules/
dist/

# --- IDE ---
.idea/
.vscode/
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- 上传目录 ---
upload/

# --- 日志 ---
*.log

# --- 环境变量（含敏感信息，仅模板可提交）---
.env
.env.local
.env.prod

# --- Docker 本地覆盖 ---
docker-compose.override.yml
docker/data/

# --- 本地开发配置（含敏感信息）---
application-local.yml
.env.local

# --- 备份 ---
backups/

# --- 部署文档（不需要提交）---
部署文档.md

# GeoLite2 离线库（66MB 二进制，需按月更新，不入 git）
# 获取方式见 docs/GEOIP-SETUP.md 或 scripts/fetch-geoip.sh
data/geoip/*.mmdb
