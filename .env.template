# ============================================================
# Lune 生产环境变量模板
# 使用方法:
#   1. cp .env.template .env
#   2. 编辑 .env 填入真实值（密码用 openssl rand -base64 32 生成）
#   3. .env 不会被提交到 Git（已在 .gitignore）
#
# 所有变量均在此声明，注释掉 = 服务使用 application.yml 默认值。
# ============================================================

# ========== 数据库 ==========
DB_ROOT_PASSWORD=change-me-use-openssl-rand-base64-32
DB_USERNAME=root
# DB_PASSWORD 默认跟随 DB_ROOT_PASSWORD（compose 里 $${DB_PASSWORD:-DB_ROOT_PASSWORD}）
DB_PASSWORD=${DB_ROOT_PASSWORD}

# ========== Redis ==========
# 留空则 Redis 无密码
REDIS_PASSWORD=

# ========== JWT ==========
# openssl rand -base64 64
JWT_SECRET=change-me-use-openssl-rand-base64-64

# ========== 邮件（QQ 邮箱示例）==========
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ========== 端口 ==========
NGINX_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379

# ========== 管理员初始密码 ==========
# DataInitializer 在 user 表为空时用此密码创建 admin
ADMIN_DEFAULT_PASSWORD=admin123

# ========== AI Agent ==========
# API Key 部署后在后台「AI 助手」→ 设置齿轮 → 动态填入保存（内存态，容器重启需重填）
# 这里只设默认的 API 网关和模型，Key 留空由 UI 运行时配置
AGENT_API_KEY=
AGENT_BASE_URL=https://aigw.phigent.cn
AGENT_MODEL=claude-haiku-4-5-20251001

# ========== 文件存储 ==========
# local = 本地磁盘（Nginx /upload/）；oss = 腾讯云 COS（需填入 OSS_*）
STORAGE_TYPE=oss

# COS 对象存储（STORAGE_TYPE=oss 时必填）
OSS_ENDPOINT=cos.ap-guangzhou.myqcloud.com
OSS_BUCKET=zt-1378526706
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# CDN 加速域名（可选，配置后资源 URL 走 CDN）
OSS_CDN_DOMAIN=https://res.ztcools.com

# ========== HTTPS / 域名 ==========
# 站点域名，替换 nginx 的 server_name 和 certbot 命令
DOMAIN=ztcools.com
# HSTS 强制 HTTPS：首次部署先设 false，HTTPS 确认可用后再改 true
HSTS_ENABLED=false
