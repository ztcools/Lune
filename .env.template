# ============================================================
# Lune 环境变量配置模板
# 使用方法:
#   1. cp .env.template .env
#   2. 编辑 .env 填入真实值
#   3. .env 文件不会被提交到 Git（已在 .gitignore 中）
#
# 生成强密码命令:
#   openssl rand -base64 32  # 数据库密码
#   openssl rand -base64 64  # JWT Secret
# ============================================================

# ========== 数据库 ==========
# MySQL root 密码（容器初始化时设置）
DB_ROOT_PASSWORD=change-me-use-openssl-rand-base64-32

# 应用数据库连接凭据
DB_USERNAME=root
DB_PASSWORD=${DB_ROOT_PASSWORD}

# ========== Redis ==========
# Redis 密码（留空则不设置密码）
REDIS_PASSWORD=

# ========== JWT ==========
# 重要：生产环境必须使用随机强密钥！
# 生成方式：openssl rand -base64 64
JWT_SECRET=change-me-use-openssl-rand-base64-64

# ========== 邮件（QQ 邮箱示例）==========
# 如不需要邮件功能，可留空
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ========== 端口配置 ==========
# Nginx 对外端口
NGINX_PORT=80

# MySQL 端口（外部访问，仅 dev 模式暴露）
MYSQL_PORT=3306

# Redis 端口（外部访问，仅 dev 模式暴露）
REDIS_PORT=6379

# ========== 管理员初始密码 ==========
# 首次部署创建 admin 账号时使用，部署后请立即在后台修改
ADMIN_DEFAULT_PASSWORD=admin123

# ========== 文件存储（本地 / OSS）==========
# local = 本地磁盘（默认，经 Nginx 提供）；oss = 对象存储（需接入 SDK）
STORAGE_TYPE=local

# OSS 预留配置（STORAGE_TYPE=oss 时生效，接入 CDN/OSS 后填写）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# CDN 加速域名（可选，配置后资源走 CDN）
OSS_CDN_DOMAIN=

# ========== HTTPS / 域名（ICP 备案完成后配置）==========
# 站点域名（如 blog.example.com）。容器不读这个变量 —— 它只是给你自己留个记录，
# 启用 HTTPS 时需要手动把它填进 docker/nginx/nginx.prod.conf 的 server_name
# 与 certbot 命令里（步骤见 docs/DEPLOYMENT.md 第四章）。
DOMAIN=
# HSTS 强制 HTTPS：证书配好后才可设为 true。
# HTTP 站点下发 HSTS 会让浏览器把 http:// 强制升级成 https:// 并记住一年，
# 等于自己把还没有证书的站点锁死，所以默认必须 false。
HSTS_ENABLED=false

# ICP 备案号不走环境变量：登录后台 → 设置 → 基础信息 → 「ICP备案号」填写即可
# （存 site_config.beian_icp，改完立即在 Landing 页脚生效，无需重启容器）
