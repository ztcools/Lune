# ============================================================
# Lune 本地开发环境变量模板
# 使用方法:
#   cp .env.local.template .env.local
#   编辑 .env.local 填入真实值
#
# 所有可配置变量均在此声明。本地开发默认走 local 存储、HTTP、无 HSTS。
# ============================================================

# ========== 数据库（本地 Docker）==========
DB_ROOT_PASSWORD=local-dev-password
DB_USERNAME=root
DB_PASSWORD=local-dev-password

# ========== Redis（本地 Docker，通常无需密码）==========
REDIS_PASSWORD=

# ========== JWT（本地开发用固定值即可）==========
JWT_SECRET=local-dev-jwt-secret-change-in-production

# ========== 邮件（可选）==========
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq-email@qq.com
MAIL_PASSWORD=your-qq-auth-code

# ========== 端口 ==========
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# ========== 管理员初始密码 ==========
ADMIN_DEFAULT_PASSWORD=admin123

# ========== AI Agent（本地开发）==========
AGENT_API_KEY=your-api-key
AGENT_BASE_URL=https://aigw.phigent.cn
AGENT_MODEL=claude-haiku-4-5-20251001

# ========== 文件存储（本地开发固定 local）==========
STORAGE_TYPE=local

# OSS / CDN 是生产侧的事，本地留空即可
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_CDN_DOMAIN=

# ========== HTTPS / 域名（本地开发不走 HTTPS）==========
# docker-compose.dev.yml 不挂载证书，443 也不暴露
DOMAIN=
HSTS_ENABLED=false
