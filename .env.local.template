# ============================================================
# Lune 本地开发环境变量（敏感信息，不提交到 Git）
# 复制此文件并填入真实值:
#   cp .env.local.template .env.local
# ============================================================

# 数据库（本地 Docker）
DB_ROOT_PASSWORD=local-dev-password
DB_USERNAME=root
DB_PASSWORD=local-dev-password

# Redis（本地 Docker）
REDIS_PASSWORD=

# JWT
JWT_SECRET=local-dev-jwt-secret-change-in-production

# 邮件（可选，填写你的 QQ 邮箱授权码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq-email@qq.com
MAIL_PASSWORD=your-qq-auth-code

# 端口
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# 管理员初始密码（本地开发）
ADMIN_DEFAULT_PASSWORD=admin123

# AI 助手 API（DeepSeek 等兼容 OpenAI 协议的接口）
AGENT_API_KEY=your-api-key
AGENT_BASE_URL=https://aigw.phigent.cn
AGENT_MODEL=deepseek/deepseek-v4-flash

# OSS / CDN / HTTPS / 备案号都是生产侧的事，docker-compose.dev.yml 不透传这些变量
# （本地固定 STORAGE_TYPE=local、HSTS 关闭；备案号在后台「设置 → 基础信息」里填）。
# 生产环境的完整清单见 .env.template。
