# ============================================================
# Lune 本地开发环境变量（敏感信息，不提交到 Git）
# 复制此文件并填入真实值:
#   cp .env.local.template .env.local
# ============================================================

# 数据库（本地 Docker）
DB_ROOT_PASSWORD=local-dev-password
DB_USERNAME=root
DB_PASSWORD=local-dev-password

# Redis（本地 Docker）
REDIS_PASSWORD=

# JWT
JWT_SECRET=local-dev-jwt-secret-change-in-production

# 邮件（可选，填写你的 QQ 邮箱授权码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq-email@qq.com
MAIL_PASSWORD=your-qq-auth-code

# 端口
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# 管理员初始密码（本地开发）
ADMIN_DEFAULT_PASSWORD=admin123

# 文件存储（本地开发用 local 即可）
STORAGE_TYPE=local

# OSS / CDN（本地开发留空，上线后填）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_CDN_DOMAIN=

# 域名与 HTTPS（本地 HTTP 开发保持默认）
DOMAIN=
HSTS_ENABLED=false
BEIAN_ICP=
