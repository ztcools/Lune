# ============================================================
# Spring Boot 本地开发配置模板
# 复制: cp application-local.yml.template application-local.yml
# application-local.yml 不提交到 Git
# ============================================================
spring:
  mail:
    host: ${MAIL_HOST:smtp.qq.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
