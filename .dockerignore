# ============================================================
# Lune Docker 构建忽略规则
# ============================================================

# Git
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Docker 文件（避免递归）
docker-compose*.yml
.env
.env.template
.dockerignore
deploy.sh
backup.sh
Makefile

# Node
node_modules/
lune-ui/node_modules/
lune-ui/dist/

# Maven
lune-server/**/target/
lune-server/lune-web/target/

# 上传目录
upload/
lune-server/lune-web/upload/

# 文档
CLAUDE.md
部署文档.md
效果图/
*.md

# 日志
*.log
logs/

# 备份
backups/

# 本地开发配置（含敏感信息）
application-local.yml
start-dev.sh

# 包管理器 lock 文件（构建时重新生成）
package-lock.json
yarn.lock
